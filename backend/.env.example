# ===== Server =====
PORT=3000
API_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ===== MySQL =====
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_NAME=academic_hub
# true: tự tạo/cập nhật bảng khi chạy (chỉ nên dùng khi phát triển)
DB_SYNCHRONIZE=true

# ===== JWT =====
JWT_SECRET=doi-chuoi-bi-mat-nay-1
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=doi-chuoi-bi-mat-nay-2
JWT_REFRESH_EXPIRES_IN=7d

# ===== Lưu trữ file: local | s3 =====
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Chỉ cần khi STORAGE_DRIVER=s3
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== Tài khoản admin tạo sẵn lần chạy đầu =====
SEED_ADMIN_EMAIL=admin@hub.local
SEED_ADMIN_PASSWORD=Admin@123

# ===== Tuỳ chọn =====
# Giới hạn gọi API mỗi phút / IP (đăng nhập, đăng ký, quên mật khẩu có hạn mức riêng: AUTH_THROTTLE_LIMIT, mặc định 10)
THROTTLE_LIMIT=300
# Tóm tắt tài liệu bằng AI (Claude). Để trống thì ẩn tính năng này.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Gửi email quên mật khẩu qua SMTP. Để trống thì link đặt lại mật khẩu chỉ in ra console (chế độ phát triển).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ===== Khi đưa lên mạng (Render...) =====
# MySQL trên cloud thường bắt buộc SSL
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Lưu file trên dịch vụ tương thích S3 (Cloudflare R2, Backblaze B2...): điền endpoint; AWS S3 thì để trống
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=true
# Render free chặn cổng SMTP → bật dòng này để link đặt lại mật khẩu hiện ngay trên trang (chỉ nên dùng khi demo)
SHOW_DEV_RESET_LINK=false
